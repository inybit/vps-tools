# docker-install 配置模板
# 安装后位于 /etc/docker-install.env（chmod 600），按需修改；留空=交互询问

# 加入 docker 组的用户（非 root 管理 docker）；留空=向导询问 / 取 sudo 调用者
DI_DOCKER_USER=

# 向导中自动放行的容器端口（逗号分隔，匹配【容器内部端口】，非宿主映射端口）
DI_ALLOW_PORTS=

# 加固委托的上游 ufw-docker 版本与校验值（默认即固定版本，一般无需改）
# DI_UFWDOCKER_VERSION=251123
# DI_UFWDOCKER_SHA256=c3e5f0bf6061a3a2e7d7ac06abc80665707d2f4c91e90d76f22e4168863fb472

# 允许互访的容器私网 CIDR（空格分隔）；留空=自动从 docker network inspect 探测
DI_DOCKER_CIDRS=

# perms check 扫描 bind mount 属主漂移的目录（空格分隔）
DI_SCAN_DIRS=/srv/docker /opt/docker

# 自动化开关：1=跳过所有确认提示（CI 场景）
DI_YES=0
