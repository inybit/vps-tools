# ============================================================
# vps-backup 配置模板
# 安装时复制到 /etc/vps-backup.env（chmod 600），真实值本机填写。
# 本文件入库，禁止写入真实密钥。
# ============================================================

# ---------- repo 位置 ----------
# ⚠️ 必须与 `rclone config` 里的 remote 名【逐字符一致】（裸名，不带冒号、不带路径）。
#    不匹配时的症状是「明明配好了却报 remote 未配置」——v1.3.0 起会打印 rclone 实有
#    remote 名与两条修正路径；v1.2.0 及更早只给一句误导文案。
#    查名字: rclone listremotes
VP_RCLONE_REMOTE="gdrive"
# remote 内的 repo 根目录（每台机器一个子目录，用 VP_HOST 区分）
VP_REPO_BASE="vps-backup"
# 本机标识（repo 子目录名 + 快照 host 标签）；留空=自动取 hostname -s
VP_HOST=""

# ---------- 备份范围（分层） ----------
# core: 体量小、频率高，恢复秒~分钟级（服务能立刻起来）
VP_BACKUP_CORE_PATHS="/etc /root /home /usr/local/lib/vps-tools /usr/local/lib/vps-backup /usr/local/bin"
# data: 体量大、频率低，可后台恢复
VP_BACKUP_DATA_PATHS="/var/lib/docker/volumes /srv /opt"

# ---------- 保留策略 ----------
# --keep-* 之间是 OR（命中任一即保留），按 host,paths 分组淘汰
VP_RETENTION_ARGS="--keep-daily 7 --keep-weekly 5 --keep-monthly 6 --keep-yearly 2"
# 每周完整性校验的数据块抽查比例（避免下载整个 repo）
VP_CHECK_SUBSET="5%"

# ---------- 调度 ----------
VP_CORE_INTERVAL_HOURS="6"
# 默认 core 每 6 小时（00/06/12/18 点 20 分）
VP_CORE_ONCALENDAR="*-*-* 00/6:20:00"
VP_DATA_ONCALENDAR="*-*-* 03:30:00"
VP_MAINTAIN_ONCALENDAR="Sun *-*-* 04:30:00"

# ---------- 失败告警（Telegram） ----------
VP_NOTIFY="1"
# 填真实值（本文件 600，不入库）；留空则不发告警
# ⚠️ 用空串而非 ${VAR} 自引用：自引用在 set -u 环境下 source 会报 unbound variable
VP_TG_BOT_TOKEN=""
VP_TG_CHAT_ID=""

# ---------- 可选 ----------
# 备份前钩子（如导出数据库；失败不阻塞备份但会告警）
VP_PRE_HOOK=""
# 非默认位置的 rclone 配置文件（如 /root/.config/rclone/rclone.conf）
VP_RCLONE_CONFIG=""
# restic 缓存目录（默认 /var/cache/vps-backup）
# ⚠️ 不要留空：systemd 单元不设 HOME，restic 找不到缓存目录会**直接失败**（定时备份全挂）。
#    工具已默认导出 RESTIC_CACHE_DIR，此项仅在你要换落点时改（须可写，且在排除表覆盖范围内）。
# VP_CACHE_DIR="/var/cache/vps-backup"

# ---------- 路径覆盖（一般不改；测试/非 root 场景可指到临时目录） ----------
# VP_PASSWORD_FILE="/etc/restic-password"
# VP_EXCLUDE_FILE="/etc/vps-backup.exclude"
# VP_RUNBOOK_FILE="/root/VPS-RESTORE.md"
